+// Cocos2d-x passes font names that are really resource paths ("fonts/Foo.ttf").
+// The Mac backend only ever looked those up as installed font families, so every
+// custom font silently fell back to the system default. Register the file with
+// CoreText instead and use its real PostScript name.
+static NSFont * _fontFromResource(const char * pFontName, int nSize)
+{
+    static NSMutableDictionary *registered = nil;
+    if (registered == nil) {
+        registered = [[NSMutableDictionary alloc] init];
+    }
+
+    NSString *name = [NSString stringWithUTF8String:pFontName];
+    if ([[name pathExtension] length] == 0) {
+        return nil;
+    }
+
+    NSString *postScriptName = [registered objectForKey:name];
+
+    if (postScriptName == nil) {
+        std::string fullPath = cocos2d::CCFileUtils::sharedFileUtils()->fullPathForFilename(pFontName);
+        NSURL *url = [NSURL fileURLWithPath:[NSString stringWithUTF8String:fullPath.c_str()]];
+
+        CGDataProviderRef provider = CGDataProviderCreateWithURL((CFURLRef)url);
+        if (! provider) {
+            return nil;
+        }
+
+        CGFontRef cgFont = CGFontCreateWithDataProvider(provider);
+        CGDataProviderRelease(provider);
+        if (! cgFont) {
+            return nil;
+        }
+
+        // Already-registered fonts report an error we can safely ignore.
+        CTFontManagerRegisterGraphicsFont(cgFont, NULL);
+        postScriptName = [(NSString *)CGFontCopyPostScriptName(cgFont) autorelease];
+        CGFontRelease(cgFont);
+
+        if (postScriptName == nil) {
+            return nil;
+        }
+        [registered setObject:postScriptName forKey:name];
+    }
+
+    return [NSFont fontWithName:postScriptName size:nSize];
+}
